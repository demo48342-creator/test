<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AltAtlas</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RazorPagees.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <div class="page-shell">
        <header class="app-header">
            <div class="nav-bar">
                <div class="nav-top">
                    <a class="brand" asp-area="" asp-page="/Index">AltAtlas</a>
                    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="navMenu">
                        <span class="nav-toggle__icon"></span>
                        <span class="sr-only">Toggle navigation</span>
                    </button>
                </div>
                <div class="nav-menu" id="navMenu">
                    <div class="nav-links">
                        <a asp-area="" asp-page="/Index">Explore</a>
                        <a asp-area="" asp-page="/Index">Roadmap</a>
                        <a asp-area="" asp-page="/Privacy">Privacy</a>
                    </div>
                    <div class="nav-actions">
                        <a class="nav-link" href="#">Submit an app</a>
                        <a class="pill pill--outline" href="#">Get updates</a>
                    </div>
                </div>
            </div>
        </header>

        <main role="main" class="main-content">
            @RenderBody()
        </main>

        <footer class="footer">
            <div class="footer__meta">
                <div>
                    <div class="brand">AltAtlas</div>
                    <p class="muted">A fast path to app alternatives without the hype.</p>
                </div>
                <div class="footer__links">
                    <a asp-area="" asp-page="/Index">Explore</a>
                    <a href="#">Roadmap</a>
                    <a asp-area="" asp-page="/Privacy">Privacy</a>
                </div>
            </div>
            <div class="footer__note">&copy; 2025 AltAtlas. Crafted for thoughtful teams.</div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
