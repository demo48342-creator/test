<!DOCTYPE html>
<html lang="en">
@{
    var pageTitle = ViewData["Title"] as string ?? "AltAtlas";
    var pageDescription = ViewData["Description"] as string ?? "AltAtlas surfaces curated app alternatives with fit notes, pricing, and product-ready briefs.";
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RazorPagees.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <a class="skip-link" href="#mainContent">Skip to main content</a>
    <div class="page-shell">
        <header class="app-header">
            <div class="nav-bar" role="navigation" aria-label="Primary">
                <div class="nav-top">
                    <a class="brand-with-mark" asp-area="" asp-page="/Index">
                        <img class="brand-mark" src="~/img/altatlas-logo.svg" alt="AltAtlas logo" />
                        <span class="brand-text">AltAtlas</span>
                    </a>
                    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="navMenu">
                        <span class="nav-toggle__icon"></span>
                        <span class="sr-only">Toggle navigation</span>
                    </button>
                </div>
                <div class="nav-menu" id="navMenu">
                    <div class="nav-links">
                        <a asp-area="" asp-page="/Index">Home</a>
                        <a asp-area="" asp-page="/Explore">Explore</a>
                        <a href="#launches">Launches</a>
                        <a asp-area="" asp-page="/Privacy">Privacy</a>
                    </div>
                    <div class="nav-actions">
                        <a class="nav-link" href="mailto:hello@altatlas.studio?subject=Submit%20a%20launch">Submit a launch</a>
                        <a class="pill pill--outline" href="#newsletter">Get updates</a>
                    </div>
                </div>
            </div>
        </header>

        <main role="main" id="mainContent" class="main-content">
            @RenderBody()
        </main>

        <partial name="_Footer" />
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
