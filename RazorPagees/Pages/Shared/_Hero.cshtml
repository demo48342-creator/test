@model RazorPagees.Models.HeroModel

<section class="hero">
    <div class="hero__text">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1>@Model.Title</h1>
        <p class="lede">@Model.Lede</p>
        <div class="hero__actions">
            <form class="search" method="get">
                <input name="query" type="search" placeholder="Search by app, problem, or category" />
                <button type="submit">Start exploring</button>
            </form>
            <div class="quick-filters">
                @foreach (var chip in Model.QuickFilters)
                {
                    <span class="chip">@chip</span>
                }
            </div>
        </div>
    </div>
    <div class="hero__panel">
        <div class="panel-header">
            <p class="eyebrow">Hot apps</p>
            <h3>Racing up today</h3>
            <a class="text-link" href="#launches">See launches</a>
        </div>
        <div class="hot-list">
            @for (var i = 0; i < Model.HotApps.Count; i++)
            {
                var rank = i + 1;
                <div class="hot-card">
                    <div class="hot-rank @(rank == 1 ? "hot-rank--gold" : rank == 2 ? "hot-rank--silver" : "hot-rank--bronze")">@rank</div>
                    <div class="hot-card__body">
                        <div class="hot-card__title">@Model.HotApps[i]</div>
                        <p class="muted">Trending launch · Vote to push it higher</p>
                    </div>
                    <span class="hot-spark">▲</span>
                </div>
            }
        </div>
        <div class="pill-board">
            @foreach (var pill in Model.PillBoard)
            {
                <span>@pill</span>
            }
        </div>
    </div>
</section>

<div class="hero-stats">
    @foreach (var stat in Model.Stats)
    {
        <div class="stat-card">
            <div class="stat-value">@stat.Value</div>
            <div class="stat-label">@stat.Label</div>
            <p class="stat-note">@stat.Note</p>
        </div>
    }
</div>
