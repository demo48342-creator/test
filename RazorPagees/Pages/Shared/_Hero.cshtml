@model RazorPagees.Models.HeroModel

@{
    var palette = Model.SearchPalette ?? new RazorPagees.Models.SearchPalette();
}

<section class="hero">
    <div class="hero__text">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1>@Model.Title</h1>
        <p class="lede">@Model.Lede</p>
        <div class="hero__actions">
            <form class="search" method="get" data-search-form aria-labelledby="searchLabel">
                <label class="sr-only" id="searchLabel" for="heroSearch">Search app alternatives</label>
                <input id="heroSearch" name="query" type="search" placeholder="Search by app, problem, or category" autocomplete="off" aria-describedby="searchHint" data-open-search />
                <button type="submit" data-open-search>Open search</button>
            </form>
            <p class="muted small-text" id="searchHint">Enter a term and press enter to browse the full-screen search, or use a shortcut below.</p>
            <div class="quick-filters" role="list" aria-label="Search shortcuts">
                @foreach (var chip in Model.QuickFilters)
                {
                    <button type="button" class="chip chip--action" data-open-search data-search-term="@chip">@chip</button>
                }
            </div>
            <nav class="category-tags" aria-label="Popular categories">
                @foreach (var cat in Model.CategoryTags)
                {
                    <a class="chip chip--link" href="/Explore/@(cat.Replace(" ", "-").ToLower())">@cat</a>
                }
            </nav>
        </div>
    </div>
    <div class="hero__panel">
        <div class="panel-header">
            <p class="eyebrow">Hot apps</p>
            <h3>Racing up today</h3>
            <a class="text-link" href="/Explore">See launches</a>
        </div>
        <div class="hot-list">
            @for (var i = 0; i < Model.HotApps.Count; i++)
            {
                var rank = i + 1;
                var app = Model.HotApps[i];
                <a class="hot-card" href="/apps/@app.Slug">
                    <div class="hot-rank @(rank == 1 ? "hot-rank--gold" : rank == 2 ? "hot-rank--silver" : "hot-rank--bronze")" aria-label="Rank @rank">@rank</div>
                    <div class="hot-card__body">
                        <div class="hot-card__title">@app.Name</div>
                        <p class="muted">@app.Category · @app.Upvotes votes</p>
                    </div>
                    <span class="hot-spark" aria-hidden="true">▲</span>
                </a>
            }
        </div>
        <div class="pill-board" role="list" aria-label="How we review">
            @foreach (var pill in Model.PillBoard)
            {
                <span role="listitem">@pill</span>
            }
        </div>
    </div>
</section>

<div class="hero-stats">
    @foreach (var stat in Model.Stats)
    {
        <div class="stat-card">
            <div class="stat-value">@stat.Value</div>
            <div class="stat-label">@stat.Label</div>
            <p class="stat-note">@stat.Note</p>
        </div>
    }
</div>

<div class="search-overlay" id="searchOverlay" aria-hidden="true">
    <div class="search-dialog" role="dialog" aria-modal="true" aria-labelledby="searchOverlayTitle">
        <div class="search-dialog__header">
            <div class="search-dialog__input">
                <span class="search-dialog__icon" aria-hidden="true">⌕</span>
                <input id="searchOverlayInput" type="search" placeholder="Search for products, launches, or people..." autocomplete="off" />
            </div>
            <button type="button" class="icon-btn search-dialog__close" data-close-search aria-label="Close search">×</button>
        </div>
        <div class="search-dialog__body">
            <div class="search-dialog__column search-dialog__column--left">
                <p class="eyebrow" id="searchOverlayTitle">Popular launch tags</p>
                <div class="chip-row">
                    @foreach (var tag in palette.PopularTags)
                    {
                        <span class="chip chip--link search-chip" data-searchable="@tag">@tag</span>
                    }
                </div>
                <a class="search-dialog__link" href="/Explore">View all launch tags</a>
                <div class="search-divider"></div>
                <div class="search-spotlight">
                    <p class="eyebrow">Spotlight results</p>
                    <div class="search-results">
                        @foreach (var app in palette.SpotlightResults)
                        {
                            <a class="search-result" href="/apps/@app.Slug" data-searchable="@($"{app.Name} {app.Category} {string.Join(' ', app.Tags)} {app.Fit} {app.Summary}")">
                                <div class="search-result__logo">
                                    <img src="@app.LogoUrl" alt="@app.Name logo" loading="lazy" />
                                </div>
                                <div class="search-result__body">
                                    <div class="search-result__title">@app.Name</div>
                                    <div class="search-result__meta">@app.Category · @app.Signal</div>
                                </div>
                                <span class="pill pill--muted">@($"{app.Upvotes} votes")</span>
                            </a>
                        }
                    </div>
                    <div class="search-divider"></div>
                    <p class="eyebrow">All products</p>
                    <div class="search-results">
                        @foreach (var app in palette.SearchableApps)
                        {
                            <a class="search-result" href="/apps/@app.Slug" data-searchable="@($"{app.Name} {app.Category} {string.Join(' ', app.Tags)} {app.Fit} {app.Summary}")">
                                <div class="search-result__logo">
                                    <img src="@app.LogoUrl" alt="@app.Name logo" loading="lazy" />
                                </div>
                                <div class="search-result__body">
                                    <div class="search-result__title">@app.Name</div>
                                    <div class="search-result__meta">@app.Category · @app.Signal</div>
                                </div>
                                <span class="pill pill--muted">@($"{app.Upvotes} votes")</span>
                            </a>
                        }
                    </div>
                    <div class="search-empty" aria-live="polite">No matches yet — try another term.</div>
                </div>
            </div>
            <div class="search-dialog__column">
                <div class="search-dialog__column-header">
                    <p class="eyebrow">Product categories</p>
                    <a class="text-link" href="/Explore">View all product categories</a>
                </div>
                <div class="search-category-grid">
                    @foreach (var set in palette.CategorySets)
                    {
                        <div class="search-category-card">
                            <div class="search-category-card__header">
                                <div class="search-category-card__title">@set.Title</div>
                                <a class="text-link" href="@set.CtaHref">@set.CtaText</a>
                            </div>
                            <ul class="search-category-list">
                                @foreach (var item in set.Items)
                                {
                                    <li class="search-category__item" data-searchable="@item">@item</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
