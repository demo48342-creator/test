@model RazorPagees.Models.ProductOption

<article class="option-card">
    <div class="option-card__meta">
        <span class="pill">@Model.Label</span>
        <span class="pill pill--muted">@Model.Pill</span>
    </div>
    <h3>@Model.Title</h3>
    <p class="muted">@Model.Body</p>
    <div class="option-card__actions">
        <a class="pill pill--outline" href="@Model.CtaHref">@Model.CtaText</a>
        <a class="text-link" href="#">View what’s included</a>
    </div>
</article>
