@model RazorPagees.Models.AppListing

<article class="app-card @(Model.IsNewLaunch ? "app-card--launch" : "app-card--classic")">
    <div class="app-card__top">
        <div class="app-card__brand">
            <div class="app-logo">
                <img src="@Model.LogoUrl" alt="@Model.Name logo" loading="lazy" />
            </div>
            <div>
                <div class="app-title-row">
                    <h3 class="app-title">
                        <a href="/apps/@Model.Slug">@Model.Name</a>
                    </h3>
                    <span class="pill">@Model.Category</span>
                </div>
                @if (!Model.IsNewLaunch)
                {
                    <p class="app-fit">Best for: @Model.Fit</p>
                }
            </div>
        </div>
        <span class="pill pill--signal" aria-label="Signal">@(!string.IsNullOrWhiteSpace(Model.Signal) ? Model.Signal : "Launch signal")</span>
    </div>

    @if (Model.IsNewLaunch)
    {
        <div class="app-card__stats">
            <div class="app-card__stat">
                <div class="app-card__stat-label">Launch</div>
                <div class="app-card__stat-value">@Model.LaunchDate.ToString("MMM dd")</div>
            </div>
            <div class="app-card__stat">
                <div class="app-card__stat-label">Score</div>
                <div class="app-card__stat-value">@Model.Score</div>
            </div>
            <div class="app-card__stat">
                <div class="app-card__stat-label">Votes</div>
                <div class="app-card__stat-value">@Model.Upvotes</div>
            </div>
            <div class="app-card__stat">
                <div class="app-card__stat-label">Views</div>
                <div class="app-card__stat-value">@Model.Views</div>
            </div>
        </div>
        @if (Model.TrustpilotScore.HasValue && Model.TrustpilotReviews.HasValue && !string.IsNullOrWhiteSpace(Model.TrustpilotUrl))
        {
            <div class="trust-row">
                <a class="pill pill--trust" href="@Model.TrustpilotUrl" target="_blank" rel="noopener">
                    ★ @Model.TrustpilotScore.Value.ToString("0.0") · @Model.TrustpilotReviews.Value.ToString("N0") reviews
                </a>
                <span class="muted">Source: Trustpilot</span>
            </div>
        }
        <div class="app-pros-cons">
            <div class="app-pros-cons__item">
                <div class="app-pros-cons__label">Pros</div>
                <div class="app-pros-cons__body">@Model.Fit</div>
            </div>
            <div class="app-pros-cons__item">
                <div class="app-pros-cons__label">Notes</div>
                <div class="app-pros-cons__body">@Model.Summary</div>
            </div>
        </div>

        <div class="vote-row vote-row--inline" aria-label="Voting for @Model.Name">
            <button type="button" class="vote-btn vote-btn--up" data-slug="@Model.Slug" data-direction="up" aria-label="Upvote @Model.Name">
                <span>▲</span>
                <span>@Model.Upvotes</span>
            </button>
            <button type="button" class="vote-btn vote-btn--down" data-slug="@Model.Slug" data-direction="down" aria-label="Downvote @Model.Name">
                <span>▼</span>
                <span>@Model.Downvotes</span>
            </button>
        </div>
        <div class="card-actions">
            <a class="pill pill--outline" href="@Model.Website" target="_blank" rel="noopener" aria-label="Open @Model.Name website">Open site</a>
            <a class="text-link" href="/apps/@Model.Slug">Launch details</a>
        </div>
    }
    else
    {
        <div class="app-summary">@Html.Raw(string.IsNullOrWhiteSpace(Model.HtmlDescription) ? Model.Summary : Model.HtmlDescription)</div>

        <div class="app-card__stats">
            <div class="app-card__stat">
                <div class="app-card__stat-label">Score</div>
                <div class="app-card__stat-value score-value">@Model.Score</div>
            </div>
            <div class="app-card__stat">
                <div class="app-card__stat-label">Votes</div>
                <div class="app-card__stat-value">@Model.Upvotes</div>
            </div>
            <div class="app-card__stat">
                <div class="app-card__stat-label">Views</div>
                <div class="app-card__stat-value">@Model.Views</div>
            </div>
            <div class="app-card__stat">
                <div class="app-card__stat-label">Comments</div>
                <div class="app-card__stat-value">@Model.CommentsCount</div>
            </div>
        </div>
        @if (Model.TrustpilotScore.HasValue && Model.TrustpilotReviews.HasValue && !string.IsNullOrWhiteSpace(Model.TrustpilotUrl))
        {
            <div class="trust-row">
                <a class="pill pill--trust" href="@Model.TrustpilotUrl" target="_blank" rel="noopener">
                    ★ @Model.TrustpilotScore.Value.ToString("0.0") · @Model.TrustpilotReviews.Value.ToString("N0") reviews
                </a>
                <span class="muted">Source: Trustpilot</span>
            </div>
        }

        <div class="app-pros-cons">
            <div class="app-pros-cons__item">
                <div class="app-pros-cons__label">Pros</div>
                <div class="app-pros-cons__body">@Model.Fit</div>
            </div>
            <div class="app-pros-cons__item">
                <div class="app-pros-cons__label">Notes</div>
                <div class="app-pros-cons__body">@Model.Summary</div>
            </div>
        </div>

        <div class="alt-list">
            @foreach (var alt in Model.Alternatives)
            {
                <div class="alt-item">
                    <div class="alt-brand">
                        <div class="alt-logo">
                            <img src="@alt.LogoUrl" alt="@alt.Name logo" loading="lazy" />
                        </div>
                        <div>
                            <div class="alt-name">@alt.Name</div>
                            <div class="alt-desc">@alt.Differentiator</div>
                        </div>
                    </div>
                    <div class="alt-meta">
                        <span class="pill pill--price">@alt.Pricing</span>
                        <a class="pill pill--ghost alt-link" href="@alt.Link" target="_blank" rel="noreferrer" aria-label="Visit @alt.Name">Visit page</a>
                    </div>
                </div>
            }
        </div>

        <div class="card-actions">
            <a class="pill pill--outline" href="@Model.Website" target="_blank" rel="noopener" aria-label="Open @Model.Name website">Open site</a>
            <a class="text-link" href="/apps/@Model.Slug">View profile</a>
        </div>
    }
</article>
