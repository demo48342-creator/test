@page
@model RazorPagees.Pages.ExploreModel
@{
    ViewData["Title"] = "Explore categories";
    ViewData["Description"] = "Discover launches by category, compare alternatives, and find new apps.";
}

<section class="section-heading">
    <div class="section-heading__text">
        <p class="eyebrow">Explore</p>
        <h2>Browse by category</h2>
        <p class="muted">Jump into the categories the community cares about. Counts reflect live launches.</p>
    </div>
</section>

<nav class="category-chips" aria-label="Categories">
    @foreach (var category in Model.Categories)
    {
        <a class="chip chip--link" href="/Explore/@category.Anchor">@category.Name (@category.Count)</a>
    }
</nav>

<section class="section-heading">
    <div class="section-heading__text">
        <p class="eyebrow">All launches</p>
        <h2>Full catalogue</h2>
        <p class="muted">Paginated view of every launch and its alternatives.</p>
    </div>
</section>
<div class="grid">
    @foreach (var app in Model.PagedApps)
    {
        <partial name="_AppCard" model="app" />
    }
</div>
@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @if (Model.PageNumber > 1)
        {
            <a class="pill pill--outline" href="/Explore?page=@(Model.PageNumber - 1)">Previous</a>
        }
        <span class="pill pill--muted">Page @Model.PageNumber of @Model.TotalPages</span>
        @if (Model.PageNumber < Model.TotalPages)
        {
            <a class="pill pill--outline" href="/Explore?page=@(Model.PageNumber + 1)">Next</a>
        }
    </div>
}

@foreach (var group in Model.CategoryGroups)
{
    <section class="category-section" id="@group.Anchor">
        <div class="section-heading">
            <div class="section-heading__text">
                <p class="eyebrow">Category</p>
                <h2>@group.Name</h2>
                <p class="muted">Top launches and alternatives inside @group.Name.</p>
            </div>
            <a class="ghost-btn" href="/Explore/@group.Anchor">View all</a>
        </div>
        <div class="grid">
            @foreach (var app in group.AppsOrEmpty)
            {
                <partial name="_AppCard" model="app" />
            }
        </div>
    </section>
}
