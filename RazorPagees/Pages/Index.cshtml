@page
@model IndexModel
@{
    ViewData["Title"] = "App Alternatives Navigator";
    ViewData["Description"] = "Discover curated alternatives to popular apps, complete with pricing, fit notes, and product-ready briefs.";
}

<partial name="_Hero" model="Model.Hero" />

<partial name="_SectionHeading" model="Model.TopHeading" />

<section class="grid">
    @foreach (var app in Model.TopApps)
    {
        <partial name="_AppCard" model="app" />
    }
</section>

<partial name="_SectionHeading" model="Model.NewHeading" />

<section class="grid" id="launches">
    @foreach (var app in Model.NewLaunches)
    {
        <partial name="_AppCard" model="app" />
    }
</section>
